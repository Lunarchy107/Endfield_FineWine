diff --git a/dlls/ntdll/unix/env.c b/dlls/ntdll/unix/env.c
index 832adfc..2956c52 100644
--- a/dlls/ntdll/unix/env.c
+++ b/dlls/ntdll/unix/env.c
@@ -352,6 +352,10 @@ static BOOL is_ignored_env_var( const char *var )
 {
     return (STARTS_WITH( var, "NIXPKGS_" ) ||
             STARTS_WITH( var, "QT_" ) ||
+            /* Endfield_FineWine: host Qt setting like QT_*; Sikarugir's launcher sets it to
